{"name":"lcs","language":"python","mode":"function","source":"class Solution:\n    def longestCommonSubsequence(self, text1: str, text2: str) -> int:\n        m, n = len(text1), len(text2)\n        dp = [[0] * (n + 1) for _ in range(m + 1)]\n        for i in range(1, m + 1):\n            for j in range(1, n + 1):\n                if text1[i - 1] == text2[j - 1]:\n                    dp[i][j] = dp[i - 1][j - 1] + 1\n                else:\n                    dp[i][j] = max(dp[i - 1][j], dp[i][j - 1])\n        return dp[m][n]\n","entry":"Solution.longestCommonSubsequence","analysis":{"ok":true,"diagnostics":[],"functions":[{"name":"longestCommonSubsequence","qualname":"Solution.longestCommonSubsequence","params":[{"name":"text1","annotation":"str"},{"name":"text2","annotation":"str"}],"line":2,"endLine":11,"className":"Solution","returnAnnotation":"int"}],"classes":[{"name":"Solution","line":1,"endLine":11,"methods":["longestCommonSubsequence"],"attrs":[]}],"accesses":[{"line":11,"base":"dp","indices":["m","n"],"indexNames":[["m"],["n"]],"write":false,"kind":"subscript"},{"line":7,"base":"text1","indices":["i - 1"],"indexNames":[["i"]],"write":false,"kind":"subscript"},{"line":7,"base":"text2","indices":["j - 1"],"indexNames":[["j"]],"write":false,"kind":"subscript"},{"line":8,"base":"dp","indices":["i","j"],"indexNames":[["i"],["j"]],"write":true,"kind":"subscript"},{"line":10,"base":"dp","indices":["i","j"],"indexNames":[["i"],["j"]],"write":true,"kind":"subscript"},{"line":8,"base":"dp","indices":["i - 1","j - 1"],"indexNames":[["i"],["j"]],"write":false,"kind":"subscript"},{"line":10,"base":"dp","indices":["i - 1","j"],"indexNames":[["i"],["j"]],"write":false,"kind":"subscript"},{"line":10,"base":"dp","indices":["i","j - 1"],"indexNames":[["i"],["j"]],"write":false,"kind":"subscript"}],"heapBases":[],"entryCandidates":["Solution.longestCommonSubsequence"],"scriptLike":false,"sizeNames":["m","n"]},"summary":{"status":"completed","diagnostics":[],"durationMs":4,"res
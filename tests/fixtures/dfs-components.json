{"name":"dfs-components","language":"python","mode":"function","source":"from typing import List\n\nclass Solution:\n    def countComponents(self, n: int, edges: List[List[int]]) -> int:\n        graph = {i: [] for i in range(n)}\n        for a, b in edges:\n            graph[a].append(b)\n            graph[b].append(a)\n        visited = set()\n\n        def dfs(node):\n            visited.add(node)\n            for nei in graph[node]:\n                if nei not in visited:\n                    dfs(nei)\n\n        components = 0\n        for node in range(n):\n            if node not in visited:\n                components += 1\n                dfs(node)\n        return components\n","entry":"Solution.countComponents","analysis":{"ok":true,"diagnostics":[],"functions":[{"name":"countComponents","qualname":"Solution.countComponents","params":[{"name":"n","annotation":"int"},{"name":"edges","annotation":"List[List[int]]"}],"line":4,"endLine":22,"className":"Solution","returnAnnotation":"int"},{"name":"dfs","qualname":"<nested>.dfs","params":[{"name":"node","annotation":null}],"line":11,"endLine":15}],"classes":[{"name":"Solution","line":3,"endLine":22,"methods":["countComponents"],"attrs":[]}],"accesses":[{"line":4,"base":"List","indices":["List[int]"],"indexNames":[["List","int"]],"write":false,"kind":"subscript"},{"line":13,"base":"graph","indices":["node"],"indexNames":[["node"]],"write":false,"kind":"subscript"},{"line":4,"base":"List","indices":["int"],"indexNames":[["int"]],"write":false,"kind":"subscript"},{"line":7,"base":"graph","indices":["a"],"indexNames":[["a"]],"write":false,"kind":"subscript"},{"line":8,"base":"graph","indices":["b"],"indexNames":[["b"]],"write":false,"kind":"subscript"}],"heapBases":[],"entryCandidates":["Solution.countComponents"],"scriptLike":false,"sizeNames":[]},"summary":{"status":"completed","diagnostics":[],"durationMs":7,"resultJson":"2","events":73},"wire":[{"type":"call","line":4,"stack":[{"id":"f1","name":"countComponents",
{"name":"house-robber","language":"python","mode":"function","source":"from typing import List\n\nclass Solution:\n    def rob(self, nums: List[int]) -> int:\n        if not nums:\n            return 0\n        dp = [0] * (len(nums) + 1)\n        dp[1] = nums[0]\n        for i in range(2, len(nums) + 1):\n            dp[i] = max(dp[i - 1], dp[i - 2] + nums[i - 1])\n        return dp[len(nums)]\n","entry":"Solution.rob","analysis":{"ok":true,"diagnostics":[],"functions":[{"name":"rob","qualname":"Solution.rob","params":[{"name":"nums","annotation":"List[int]"}],"line":4,"endLine":11,"className":"Solution","returnAnnotation":"int"}],"classes":[{"name":"Solution","line":3,"endLine":11,"methods":["rob"],"attrs":[]}],"accesses":[{"line":8,"base":"dp","indices":["1"],"indexNames":[[]],"write":true,"kind":"subscript"},{"line":8,"base":"nums","indices":["0"],"indexNames":[[]],"write":false,"kind":"subscript"},{"line":11,"base":"dp","indices":["len(nums)"],"indexNames":[["len","nums"]],"write":false,"kind":"subscript"},{"line":4,"base":"List","indices":["int"],"indexNames":[["int"]],"write":false,"kind":"subscript"},{"line":10,"base":"dp","indices":["i"],"indexNames":[["i"]],"write":true,"kind":"subscript"},{"line":10,"base":"dp","indices":["i - 1"],"indexNames":[["i"]],"write":false,"kind":"subscript"},{"line":10,"base":"dp","indices":["i - 2"],"indexNames":[["i"]],"write":false,"kind":"subscript"},{"line":10,"base":"nums","indices":["i - 1"],"indexNames":[["i"]],"write":false,"kind":"subscript"},{"line":9,"base":"nums","indices":["i"],"indexNames":[["i"]],"write":false,"kind":"loop"}],"heapBases":[],"entryCandidates":["Solution.rob"],"scriptLike":false,"sizeNames":[]},"summary":{"status":"completed","diagnostics":[],"durationMs":0,"resultJson":"4","events":14},"wire":[{"type":"call","line":4,"stack":[{"id":"f1","name":"rob","line":4,"args":["self","nums"],"locals":[["self",{"t":"ref","id":"o1"}],["nums",{"t":"ref","id":"o2"}]]}],"globals":[["Solution",{"t":"ref","id":"o3"}